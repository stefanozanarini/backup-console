="&lt;b&gt;Entra ID&lt;/b&gt;&lt;br&gt;OIDC + MFA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="160" height="50" as="geometry"/></mxCell><mxCell id="auth-5" value="JWT (Bearer)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="530" y="130" width="140" height="50" as="geometry"/></mxCell><mxCell id="auth-6" value="&lt;b&gt;api · get_current_user&lt;/b&gt;&lt;br&gt;verifica firma su JWKS,&lt;br&gt;issuer e audience" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="120" width="190" height="70" as="geometry"/></mxCell><mxCell id="auth-7" value="login" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="auth-3" target="auth-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auth-8" value="id/access token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="auth-4" target="auth-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auth-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="auth-5" target="auth-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auth-10" value="&lt;b&gt;Utente pre-registrato?&lt;/b&gt;&lt;br&gt;match su oidc_subject, poi email&lt;br&gt;(primo login: salva subject)&lt;br&gt;nessun utente → &lt;b&gt;403&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="230" width="250" height="90" as="geometry"/></mxCell><mxCell id="auth-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="auth-6" target="auth-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auth-12" value="&lt;b&gt;Login locale&lt;/b&gt; (temporaneo, BC_LOCAL_LOGIN=true)&lt;br&gt;email + password + codice TOTP&lt;br&gt;→ token di sessione (nel DB solo l'hash, con scadenza)&lt;br&gt;password impostate solo da CLI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="70" y="230" width="390" height="90" as="geometry"/></mxCell><mxCell id="auth-13" value="stesso utente, altri ruoli invariati" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="auth-12" target="auth-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auth-14" value="&lt;b&gt;Ruoli&lt;/b&gt;&lt;br&gt;superadmin: tutto, utenti, rilasci, shell&lt;br&gt;operator: globale o per tenant&lt;br&gt;tenant_admin / tenant_viewer (futuri)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="70" y="360" width="390" height="90" as="geometry"/></mxCell><mxCell id="auth-15" value="&lt;b&gt;tenant_scope()&lt;/b&gt; · filtro unico&lt;br&gt;oggetti di altri tenant → 404&lt;br&gt;ogni azione → audit_log (append-only)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="500" y="360" width="390" height="90" as="geometry"/></mxCell><mxCell id="auth-16" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="auth-10" target="auth-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auth-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="auth-14" target="auth-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auth-18" value="&lt;b&gt;Sessione elevata&lt;/b&gt; (per comandi remoti, pulizia, rilancio backup)&lt;br&gt;TOTP personale (seed cifrato con secret.key, codice monouso)&lt;br&gt;+ &lt;b&gt;motivo&lt;/b&gt; obbligatorio → token valido 15 min, solo nella scheda del browser&lt;br&gt;reset: python -m app.cli reset-totp &amp;lt;email&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="70" y="490" width="820" height="90" as="geometry"/></mxCell><mxCell id="auth-19" value="azioni sensibili" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="auth-15" target="auth-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auth-20" value="B · AGENTI (/agent/v1) · mTLS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="960" y="80" width="900" height="560" as="geometry"/></mxCell><mxCell id="auth-21" value="&lt;b&gt;Token di enrollment&lt;/b&gt;&lt;br&gt;per tenant + sito, 2 h – 7 gg&lt;br&gt;1 o N dispositivi, revocabile&lt;br&gt;nel DB solo l'hash" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="990" y="130" width="250" height="100" as="geometry"/></mxCell><mxCell id="auth-22" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="120" width="26" height="26" as="geometry"/></mxCell><mxCell id="auth-23" value="&lt;b&gt;Download installer&lt;/b&gt;&lt;br&gt;GET /agent/v1/download/{piattaforma}&lt;br&gt;header X-Enroll-Token (mai nell'URL)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1290" y="130" width="250" height="100" as="geometry"/></mxCell><mxCell id="auth-24" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1280" y="120" width="26" height="26" as="geometry"/></mxCell><mxCell id="auth-25" value="&lt;b&gt;Enroll&lt;/b&gt;&lt;br&gt;l'agente genera la chiave EC sul dispositivo&lt;br&gt;POST /agent/v1/enroll: token + CSR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1590" y="130" width="250" height="100" as="geometry"/></mxCell><mxCell id="auth-26" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1580" y="120" width="26" height="26" as="geometry"/></mxCell><mxCell id="auth-27" value="&lt;b&gt;CA interna&lt;/b&gt; firma il certificato&lt;br&gt;CN = agent_id (subject richiesto ignorato)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1590" y="270" width="250" height="100" as="geometry"/></mxCell><mxCell id="auth-28" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1580" y="260" width="26" height="26" as="geometry"/></mxCell><mxCell id="auth-29" value="&lt;b&gt;pending&lt;/b&gt; → un operatore &lt;b&gt;approva&lt;/b&gt;&lt;br&gt;(anche in blocco): un token trapelato&lt;br&gt;non basta a registrare macchine" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1290" y="270" width="250" height="100" as="geometry"/></mxCell><mxCell id="auth-30" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1280" y="260" width="26" height="26" as="geometry"/></mxCell><mxCell id="auth-31" value="&lt;b&gt;Ogni richiesta&lt;/b&gt;: nginx verifica il certificato client&lt;br&gt;su agent-ca.crt e aggiunge X-Client-Verify,&lt;br&gt;X-Client-Cert, X-Proxy-Secret (sempre sovrascritti)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="990" y="270" width="250" height="100" as="geometry"/></mxCell><mxCell id="auth-32" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="260" width="26" height="26" as="geometry"/></mxCell><mxCell id="auth-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="auth-21" target="auth-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auth-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="auth-23" target="auth-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auth-35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="auth-25" target="auth-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auth-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="auth-27" target="auth-29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auth-37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="auth-29" target="auth-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auth-38" value="&lt;b&gt;api&lt;/b&gt;: controlla X-Proxy-Secret e X-Client-Verify,&lt;br&gt;calcola la SHA-256 del certificato e cerca l'agente per impronta&lt;br&gt;→ &lt;b&gt;revoca immediata&lt;/b&gt; senza CRL · endpoint dati solo se &lt;b&gt;approvato&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="990" y="420" width="850" height="70" as="geometry"/></mxCell><mxCell id="auth-39" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="410" width="26" height="26" as="geometry"/></mxCell><mxCell id="auth-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="auth-31" target="auth-38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auth-41" value="&lt;b&gt;Esecuzione remota&lt;/b&gt;: attiva di default, disattivabile solo in installazione (-disable-remote-exec);&lt;br&gt;la console la mostra ma non può riattivarla · riga nel log locale del dispositivo per ogni comando" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="990" y="520" width="850" height="70" as="geometry"/></mxCell><mxCell id="auth-42" value="C · CODICE FIRMATO (binari agente e pacchetti di raccolta)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1330" height="330" as="geometry"/></mxCell><mxCell id="auth-43" value="&lt;b&gt;GitHub Environment agent-release&lt;/b&gt;&lt;br&gt;chiave privata Ed25519&lt;br&gt;(mai sulla console)&lt;br&gt;approvazione manuale" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="70" y="740" width="250" height="100" as="geometry"/></mxCell><mxCell id="auth-44" value="&lt;b&gt;bc-release sign / pack&lt;/b&gt;&lt;br&gt;firma binari + manifest&lt;br&gt;firma collector-pack.json" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="740" width="230" height="100" as="geometry"/></mxCell><mxCell id="auth-45" value="&lt;b&gt;Console&lt;/b&gt;&lt;br&gt;verifica hash + firma (BC_RELEASE_PUBLIC_KEY)&lt;br&gt;conserva e distribuisce,&lt;br&gt;&lt;b&gt;non può firmare&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="670" y="740" width="280" height="100" as="geometry"/></mxCell><mxCell id="auth-46" value="&lt;b&gt;Agente&lt;/b&gt;&lt;br&gt;chiave pubblica incorporata nel binario&lt;br&gt;(-X upgrade.PublicKey)&lt;br&gt;esegue &lt;b&gt;solo&lt;/b&gt; codice con firma valida" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="740" width="320" height="100" as="geometry"/></mxCell><mxCell id="auth-47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="auth-43" target="auth-44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auth-48" value="chiave API scope releases:upload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="auth-44" target="auth-45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auth-49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="auth-45" target="auth-46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auth-50" value="Conseguenza: nemmeno chi controlla la console può far eseguire codice arbitrario agli agenti (nuovi binari o nuove probe).&lt;br&gt;Firma non valida → l'agente resta sulla versione / sul pacchetto precedente." style="text;html=1;fontSize=12;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="870" width="1260" height="50" as="geometry"/></mxCell><mxCell id="auth-51" value="Fase 2 (hardening previsto): firma dei comandi nel browser con la chiave personale dell'operatore." style="text;html=1;fontSize=12;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="930" width="1260" height="30" as="geometry"/></mxCell><mxCell id="auth-52" value="D · AUTOMAZIONI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1410" y="680" width="450" height="330" as="geometry"/></mxCell><mxCell id="auth-53" value="&lt;b&gt;Chiavi API&lt;/b&gt; bck_…&lt;br&gt;nel DB solo l'hash SHA-256&lt;br&gt;valgono solo per gli scope assegnati&lt;br&gt;&lt;br&gt;&lt;b&gt;releases:upload&lt;/b&gt;: la CI carica rilasci dell'agente&lt;br&gt;e pacchetti di raccolta.&lt;br&gt;Non può avviare aggiornamenti: quelli restano&lt;br&gt;un'azione del superadmin in console." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1440" y="740" width="390" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flow" name="3 · Flussi dati e comandi"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="flow-1" value="Flussi agente ↔ console" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="flow-2" value="Envelope comune {msg_id, seq, ts, payload}: msg_id rende idempotente il reinvio." style="text;html=1;fontSize=13;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1200" height="24" as="geometry"/></mxCell><mxCell id="flow-3" value="AGENTE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="430" height="1000" as="geometry"/></mxCell><mxCell id="flow-4" value="&lt;b&gt;Heartbeat&lt;/b&gt; (timer)&lt;br&gt;stato, versione, ruoli, capacità, stato probe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="370" height="60" as="geometry"/></mxCell><mxCell id="flow-5" value="&lt;b&gt;Inventario&lt;/b&gt; · &lt;b&gt;Metriche&lt;/b&gt; · &lt;b&gt;Eventi&lt;/b&gt;&lt;br&gt;modello, seriale, dischi, IP, Supremo ID…&lt;br&gt;disk.*, hw.*, raid.healthy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="70" y="250" width="370" height="70" as="geometry"/></mxCell><mxCell id="flow-6" value="&lt;b&gt;Collector integrati&lt;/b&gt; (fallback)&lt;br&gt;Veeam B&amp;amp;R / Veeam Agent / Uranium (PowerShell)&lt;br&gt;Synology Hyper Backup" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="70" y="360" width="370" height="70" as="geometry"/></mxCell><mxCell id="flow-7" value="&lt;b&gt;Pacchetto di raccolta&lt;/b&gt;&lt;br&gt;probe con condizioni (servizio, file, dir…)&lt;br&gt;ogni 30 s valuta quali sono dovute, max 2 in parallelo&lt;br&gt;timeout + retry prelude, output max 8 MB" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="370" height="90" as="geometry"/></mxCell><mxCell id="flow-8" value="&lt;b&gt;Long-poll comandi&lt;/b&gt;&lt;br&gt;shell (sh / PowerShell / bash / pwsh / cmd)&lt;br&gt;upgrade · pulizia Veeam · avvio job&lt;br&gt;output a blocchi ogni 1 s (max 1 MB)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="70" y="610" width="370" height="90" as="geometry"/></mxCell><mxCell id="flow-9" value="&lt;b&gt;Finestra di backup&lt;/b&gt; (PC)&lt;br&gt;no sospensione durante la finestra&lt;br&gt;avviso tray: promemoria + al logon" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="70" y="750" width="370" height="70" as="geometry"/></mxCell><mxCell id="flow-10" value="&lt;b&gt;Auto-aggiornamento&lt;/b&gt;&lt;br&gt;vedi pagina 4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" v