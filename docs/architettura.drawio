ffffff;" edge="1" parent="1" source="rel-38" target="rel-41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rel-44" value="PACCHETTO DI RACCOLTA · tag pack-vX.Y.Z (nessun aggiornamento degli agenti)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1820" height="210" as="geometry"/></mxCell><mxCell id="rel-45" value="&lt;b&gt;packs/&lt;/b&gt;&lt;br&gt;probes.json + scripts/*.ps1&lt;br&gt;(condizioni, intervallo,&lt;br&gt;timeout, retry)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="70" y="645" width="230" height="150" as="geometry"/></mxCell><mxCell id="rel-46" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="635" width="26" height="26" as="geometry"/></mxCell><mxCell id="rel-47" value="&lt;b&gt;packs.yml&lt;/b&gt; · job check&lt;br&gt;bc-release pack --verify&lt;br&gt;test: script identici ai fallback" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="325" y="645" width="230" height="150" as="geometry"/></mxCell><mxCell id="rel-48" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="315" y="635" width="26" height="26" as="geometry"/></mxCell><mxCell id="rel-49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rel-45" target="rel-47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rel-50" value="&lt;b&gt;approvazione&lt;/b&gt;&lt;br&gt;firma Ed25519&lt;br&gt;collector-pack.json + .sig" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="645" width="230" height="150" as="geometry"/></mxCell><mxCell id="rel-51" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="570" y="635" width="26" height="26" as="geometry"/></mxCell><mxCell id="rel-52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rel-47" target="rel-50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rel-53" value="&lt;b&gt;upload&lt;/b&gt;&lt;br&gt;POST /api/v1/collector-packs&lt;br&gt;→ diventa &lt;b&gt;attivo&lt;/b&gt;&lt;br&gt;(“Attiva” per tornare indietro)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="835" y="645" width="230" height="150" as="geometry"/></mxCell><mxCell id="rel-54" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="825" y="635" width="26" height="26" as="geometry"/></mxCell><mxCell id="rel-55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rel-50" target="rel-53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rel-56" value="&lt;b&gt;heartbeat&lt;/b&gt;&lt;br&gt;versione + SHA-256&lt;br&gt;del pacchetto attivo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1090" y="645" width="230" height="150" as="geometry"/></mxCell><mxCell id="rel-57" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1080" y="635" width="26" height="26" as="geometry"/></mxCell><mxCell id="rel-58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rel-53" target="rel-56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rel-59" value="&lt;b&gt;agente&lt;/b&gt;&lt;br&gt;scarica, verifica la firma,&lt;br&gt;salva in collector-pack.json&lt;br&gt;firma errata → tiene il precedente" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1345" y="645" width="230" height="150" as="geometry"/></mxCell><mxCell id="rel-60" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1335" y="635" width="26" height="26" as="geometry"/></mxCell><mxCell id="rel-61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rel-56" target="rel-59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rel-62" value="&lt;b&gt;probe → /agent/v1/probe&lt;/b&gt;&lt;br&gt;la console interpreta l'output&lt;br&gt;stato per dispositivo:&lt;br&gt;Agente → Raccolta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1600" y="645" width="230" height="150" as="geometry"/></mxCell><mxCell id="rel-63" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1590" y="635" width="26" height="26" as="geometry"/></mxCell><mxCe