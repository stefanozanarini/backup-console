# Copiare in .env e compilare. Non committare .env.

# Indirizzo pubblico (lo stesso per console e agenti), usato nei comandi di installazione.
BC_PUBLIC_URL=https://backup-console.agsmedia.it

POSTGRES_PASSWORD=cambiami-con-una-password-lunga
# Segreto condiviso con l'nginx di bordo (stesso valore in edge/.env): openssl rand -hex 32
BC_PROXY_SECRET=

# Dati persistenti sull'host: ca/, postgres/, releases/, backup/ (vedi docs/deploy-azure.md).
BC_DATA_DIR=/dati/containers/backup-console/data
# Stack nginx di bordo (condiviso con le altre applicazioni): deploy.sh --edge ci copia
# il template della console e lo ricarica.
EDGE_DIR=/dati/containers/common/nginx
# Rete Docker creata dallo stack edge/.
PROXY_NETWORK=proxy

# Versione della console (tag console-backup-vX.Y.Z → immagini :X.Y.Z su GHCR). La aggiorna
# ./deploy.sh --version X.Y.Z; per tornare indietro basta rilanciarlo con la precedente.
BC_VERSION=0.1.0
# Solo per immagini costruite in locale (sviluppo): sostituiscono quelle di GHCR.
# BACKEND_IMAGE=backup-console-backend:dev
# FRONTEND_IMAGE=backup-console-frontend:dev

# Login con utente locale (password + TOTP), in aggiunta a Entra ID. Temporaneo: da
# rimettere a false quando il login Entra ID funziona. Password da CLI:
#   docker compose exec api python -m app.cli set-password <email>
BC_LOCAL_LOGIN=false

# Entra ID: app registration dell'API (token v2: nel manifest requestedAccessTokenVersion = 2)
BC_AUTH_MODE=oidc
BC_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# Con i token v2 l'audience è il client ID (GUID) dell'app API, non l'Application ID URI.
BC_OIDC_AUDIENCE=<client-id-api>
BC_OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# App registration SPA del frontend (MSAL)
BC_OIDC_SPA_CLIENT_ID=<client-id-spa>
BC_OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
BC_OIDC_SCOPE=api://backup-console/access

# Chiave pubblica dei rilasci (facoltativa: controllo anticipato al caricamento)
BC_RELEASE_PUBLIC_KEY=
