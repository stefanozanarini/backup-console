# Copiare in .env e compilare. Non committare .env.

CONSOLE_HOST=console.example.com
AGENTS_HOST=agents.example.com
ACME_EMAIL=it@example.com

POSTGRES_PASSWORD=cambiami-con-una-password-lunga

# Immagine pubblicata dalla CI su GHCR
BACKEND_IMAGE=ghcr.io/stefanozanarini/backup-console-backend:latest

# Entra ID (App registration dell'API)
BC_AUTH_MODE=oidc
BC_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
BC_OIDC_AUDIENCE=api://backup-console
BC_OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys

# Sviluppo locale: CADDYFILE=Caddyfile.dev, host *.localhost, BC_AUTH_MODE=dev
CADDYFILE=Caddyfile
