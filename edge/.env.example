# Nomi serviti per la Backup Console (separati da spazio; il primo è quello principale).
BC_HOSTNAMES=backup-console.agsmedia.it
BC_DATA_DIR=/srv/backup-console
# Segreto condiviso con l'api della console (stesso valore nel suo .env): openssl rand -hex 32
BC_PROXY_SECRET=
PROXY_NETWORK=proxy

# Solo per test locali: porte diverse da 80/443.
# HTTP_PORT=18080
# HTTPS_PORT=18443
